# Copy to .env and fill in. .env is gitignored; never commit real keys.

# OpenAI-compatible LLM endpoint. Revenue Lens investigation requires LLM_API_KEY; empty reports unavailable.
# NVIDIA hosted Nemotron (key from build.nvidia.com):
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_API_KEY=

# Meterless Runtime instead (token from <stateDir>/proxy-token):
# LLM_BASE_URL=http://127.0.0.1:8088/v1
# LLM_MODEL=meterless/auto
# LLM_API_KEY=

# LLM_TIMEOUT_MS=180000

# Zetaris. Either set ZETARIS_EMAIL / ZETARIS_PASSWORD, or point at a local
# install whose .env holds the admin login.
ZETARIS_URL=http://localhost:3000
ZETARIS_PLATFORM_DIR=~/zetaris/zetaris-platform
# ZETARIS_EMAIL=
# ZETARIS_PASSWORD=
