# Copy to .env and fill in. .env is gitignored; never commit real keys.

# OpenAI-compatible LLM endpoint. Leave LLM_API_KEY empty for retrieval-only mode.
# NVIDIA hosted Nemotron (key from build.nvidia.com):
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_API_KEY=

# Meterless Runtime instead (token from <stateDir>/proxy-token):
# LLM_BASE_URL=http://127.0.0.1:8088/v1
# LLM_MODEL=meterless/auto
# LLM_API_KEY=

# LLM_TIMEOUT_MS=180000
